# Secrets — never bake into the image
.env
.env.*
!.env.example

# Local runtime state (mounted as volumes instead)
instance/
uploads/
docker-data/

# Local ML artifacts (regenerated by train_model.py during build)
data/
ml/models/*.pkl
ml/models/*.joblib

# VCS and metadata
.git
.gitignore

# Python artifacts
__pycache__/
**/__pycache__/
*.py[cod]

# Logs
*.log
logs/
